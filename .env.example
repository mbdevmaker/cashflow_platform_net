# Credenciais LOCAIS de desenvolvimento (não são segredos reais). Copie para .env:  cp .env.example .env
POSTGRES_CASHFLOW_USER=cashflow
POSTGRES_CASHFLOW_PASSWORD=cashflow_dev_pwd
POSTGRES_CONSOLIDATION_USER=consolidation
POSTGRES_CONSOLIDATION_PASSWORD=consolidation_dev_pwd

RABBITMQ_USER=cashflow
RABBITMQ_PASSWORD=cashflow_dev_pwd
RABBITMQ_VHOST=cashflow

GRAFANA_ADMIN_PASSWORD=admin

# Chave HMAC dos tokens de desenvolvimento (>= 32 caracteres). Só é aceita com ASPNETCORE_ENVIRONMENT=Development.
DEV_JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

# Portas do host para acessar os bancos fora do Docker (troque se já houver PostgreSQL/Redis local nessas portas)
POSTGRES_CASHFLOW_HOST_PORT=5432
POSTGRES_CONSOLIDATION_HOST_PORT=5433
REDIS_HOST_PORT=6379
