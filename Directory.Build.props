<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1848/CA1873: LoggerMessage delegates; CA1711/CA1716/CA1724: nomes de domínio; CA2007: ConfigureAwait desnecessário em ASP.NET Core -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1711;CA1716;CA1724;CA2007;CA1062;CA1031;CA1515;CA1812;CA1859;CA1307;CA1304;CA1305;CA1311;CA1308;CA1819;CA1056;CA1054;CA2234;CA1002;CA1305;CA1863;CA2000;CA1032;CA1064;CA1822</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
